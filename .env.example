# ─────────────────────────────────────────────────────────────
#  jlaw-workhub 환경변수  (Vercel → Settings → Environment Variables 에 동일하게 입력)
#  자세한 발급 방법은 docs/SETUP.md 참고
# ─────────────────────────────────────────────────────────────

# [필수] Notion 내부 통합(Integration) 토큰. 에너빌드작업·작업일지 DB에 "연결" 해야 합니다.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxx
# (기본값 있음) 에너빌드작업 DB / 작업일지 DB / 내 Notion 사용자 ID
NOTION_TASKS_DB_ID=4abb47d5588f43fd83e83fe943082cd8
NOTION_WORKLOG_DB_ID=15ffa6101c6944249a6ca7394ecb5b02
NOTION_ME_USER_ID=63428ed9-eebd-4bcc-9d76-cb550c3e528d
# (선택) Notion 자동화 웹훅 URL 뒤에 ?secret=… 로 붙일 값
NOTION_WEBHOOK_SECRET=아무-긴-문자열

# [필수] Slack 앱 Bot Token(xoxb-…)과 Signing Secret
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (기본값 있음) #할일 / #작업일지 / #업무 채널 ID
SLACK_CHANNEL_TODO=C0BUFBDQKM5
SLACK_CHANNEL_WORKLOG=C0BUYKMLCLR
SLACK_CHANNEL_WORK=C0BU86WLRGC
# (선택) 업무 할당 알림을 DM으로 받을 내 Slack 사용자 ID (프로필 → ⋯ → 멤버 ID 복사)
SLACK_ME_USER_ID=

# [선택] Google Calendar 연동: 서비스 계정 JSON 키 파일 내용을 한 줄로 그대로 붙여넣기
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=jlaw080@gmail.com

# [선택] Obsidian 볼트 연동: 볼트를 올린 GitHub 저장소와 토큰(Contents: Read and write 권한)
OBSIDIAN_REPO=jlaw080-ops/obsidian-vault
OBSIDIAN_BRANCH=main
GITHUB_TOKEN=github_pat_xxxxxxxx
OBSIDIAN_TASKS_DIR=WorkHub/Tasks
OBSIDIAN_WORKLOG_DIR=WorkHub/Worklog
OBSIDIAN_INBOX_DIR=WorkHub/Inbox

# [권장] Cron·수동 실행·GitHub 웹훅 보호용 비밀값 (아무 긴 문자열)
CRON_SECRET=아무-긴-문자열
