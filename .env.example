# ─────────────────────────────────────────────────────────────
#  jlaw-workhub 환경변수  (Vercel → Settings → Environment Variables 에 동일하게 입력)
#  자세한 발급 방법은 docs/SETUP.md 참고
# ─────────────────────────────────────────────────────────────

# [필수] 창고: Obsidian 볼트(Vault_jlaw80)를 올려 둔 GitHub 저장소 (비공개) + 토큰(Contents: Read and write)
VAULT_REPO=jlaw080-ops/Vault_jlaw80
VAULT_BRANCH=main
GITHUB_TOKEN=github_pat_xxxxxxxx
# (기본값 있음) 볼트 폴더 규칙 — 기존 스킬(todo-capture 등)과 동일
VAULT_TODO_DIR=06_To Do
VAULT_DAILY_DIR=05_Daily
VAULT_PROJECTS_DIR=01_Projects
VAULT_META_DIR=.workhub
OBSIDIAN_VAULT_NAME=Vault_jlaw80

# [필수] Slack 앱 Bot Token(xoxb-…)과 Signing Secret
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (기본값 있음) #할일 / #작업일지 / #업무 채널 ID
SLACK_CHANNEL_TODO=C0BUFBDQKM5
SLACK_CHANNEL_WORKLOG=C0BUYKMLCLR
SLACK_CHANNEL_WORK=C0BU86WLRGC
# (선택) 할당 알림을 DM으로도 받을 내 Slack 사용자 ID (프로필 → ⋯ → 멤버 ID 복사)
SLACK_ME_USER_ID=

# [선택] Notion 에너빌드작업 보드 (읽기 전용: 할당 후보 / 상태 확인)
NOTION_TOKEN=
NOTION_TICKETS_DB_ID=4abb47d5588f43fd83e83fe943082cd8
NOTION_ME_USER_ID=63428ed9-eebd-4bcc-9d76-cb550c3e528d
NOTION_WEBHOOK_SECRET=
NOTION_COMMENT_SCAN_LIMIT=40

# [선택] Google Calendar: 서비스 계정 JSON 키 파일 내용을 그대로 붙여넣기
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=jlaw080@gmail.com

# [권장] Cron·수동 실행 보호용 비밀값 (아무 긴 문자열)
CRON_SECRET=

# [선택] 할일 폴더 안에서 무시할 하위 폴더 이름 (쉼표 구분). 아카이브 이름이 특이할 때만
VAULT_TODO_EXCLUDE=

# [선택] 전체 구조 문서를 올려 둔 공개 웹페이지 주소. 넣으면 Slack 도움말에 링크가 붙습니다
DOC_URL=
